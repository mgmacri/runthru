default_platform(:android)

platform :android do
  desc "Push a new beta build to Google Play internal testing"
  lane :beta do
    build_android_app(
      task: "bundle",
      build_type: "Release",
    )
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      # Inline service-account JSON from the CI secret manager — never a
      # checked-in file path.
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY_DATA"],
    )
  end

  desc "Promote to production on Google Play"
  lane :release do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY_DATA"],
    )
  end
end
