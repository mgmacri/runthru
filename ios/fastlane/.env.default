# ─────────────────────────────────────────────────────────────────────────────
# .env.default — Environment variables for Fastlane (RunThru)
#
# ⚠️  DO NOT commit this file with real values. Add ios/fastlane/.env* to
#    .gitignore. On Codemagic CI, set these in the Secrets/Environment section.
# ─────────────────────────────────────────────────────────────────────────────

# ── App Store Connect API Key ────────────────────────────────────────────────
# Generate at: https://appstoreconnect.apple.com/access/integrations/api
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Base64-encoded .p8 key content (encode with: base64 -i AuthKey_XXXXXXXXXX.p8)
APP_STORE_CONNECT_API_KEY_CONTENT=BASE64_ENCODED_KEY_CONTENT_HERE

# ── Apple Developer Account ─────────────────────────────────────────────────
APPLE_ID=mattmacri89@gmail.com
TEAM_ID=273TZKZB3M
# Numeric App Store Connect team ID (find in Users & Access)
ITC_TEAM_ID=YOUR_ITC_TEAM_ID

# ── App Identifiers ─────────────────────────────────────────────────────────
APP_IDENTIFIER=com.mgmacri.runthru
SHARE_EXTENSION_IDENTIFIER=com.mgmacri.runthru.ShareExtension

# ── Match (Code Signing) ────────────────────────────────────────────────────
# Passphrase used to encrypt/decrypt certs in the match repo
MATCH_PASSWORD=YOUR_MATCH_ENCRYPTION_PASSWORD
# GitHub personal access token (for match git repo access on CI)
MATCH_GIT_BASIC_AUTHORIZATION=YOUR_BASE64_ENCODED_TOKEN

# ── Build Configuration ─────────────────────────────────────────────────────
# Override the Xcode scheme if needed (default: Runner)
# SCHEME=Runner

# ── Notifications (optional) ─────────────────────────────────────────────────
# Slack webhook URL for build notifications
# SLACK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
