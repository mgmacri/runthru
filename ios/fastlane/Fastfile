# ─────────────────────────────────────────────────────────────────────────────
# Fastfile — RunThru iOS (Flutter) build automation
#
# Usage:
#   bundle exec fastlane ios sync_certs        # Fetch/create signing certs
#   bundle exec fastlane ios beta              # Build → TestFlight
#   bundle exec fastlane ios release           # Build → App Store
#   bundle exec fastlane ios screenshots       # Capture screenshots
#   bundle exec fastlane ios metadata          # Sync App Store metadata
#   bundle exec fastlane ios register_devices  # Register new test devices
#   bundle exec fastlane ios refresh_profiles  # Force-refresh provisioning
#
# This setup complements the existing Codemagic CI pipeline. All lanes use
# the App Store Connect API key (no password auth required).
# ─────────────────────────────────────────────────────────────────────────────

default_platform(:ios)

# ── Constants ────────────────────────────────────────────────────────────────
MAIN_APP_ID       = "com.mgmacri.runthru"
SHARE_EXT_ID      = "com.mgmacri.runthru.ShareExtension"
ALL_APP_IDS       = [MAIN_APP_ID, SHARE_EXT_ID]
WORKSPACE         = "Runner.xcworkspace"
SCHEME            = "Runner"
XCODE_PROJECT     = "Runner.xcodeproj"

platform :ios do

  # ──────────────────────────────────────────────────────────────────────────
  # Lifecycle hooks
  # ──────────────────────────────────────────────────────────────────────────

  # Runs before every lane. Ensures the working copy is clean so builds are
  # reproducible. Pass skip_clean:true to override (useful during local dev).
  before_all do |lane, options|
    unless options[:skip_clean]
      ensure_git_status_clean
    end
  end

  # Runs after every successful lane.
  after_all do |lane|
    notification(
      title: "RunThru — Fastlane",
      subtitle: "✅ #{lane} succeeded",
      message: "Lane '#{lane}' completed successfully."
    )
    # Uncomment for Slack notifications:
    # slack(
    #   message: "✅ Lane `#{lane}` succeeded!",
    #   slack_url: ENV["SLACK_URL"],
    #   default_payloads: [:lane, :git_branch, :git_author]
    # )
  end

  # Runs when any lane hits an error.
  error do |lane, exception|
    notification(
      title: "RunThru — Fastlane",
      subtitle: "❌ #{lane} failed",
      message: exception.message
    )
    # Uncomment for Slack notifications:
    # slack(
    #   message: "❌ Lane `#{lane}` failed: #{exception.message}",
    #   slack_url: ENV["SLACK_URL"],
    #   success: false,
    #   default_payloads: [:lane, :git_branch, :git_author]
    # )
  end

  # ──────────────────────────────────────────────────────────────────────────
  # Private lane: App Store Connect API Key
  # ──────────────────────────────────────────────────────────────────────────
  # Constructs an API key object from environment variables. This is used by
  # every lane that interacts with Apple services, so no Apple ID password or
  # 2FA is ever needed. Set these env vars in .env.default or in your CI
  # secret manager (Codemagic).
  #
  # Required env vars:
  #   APP_STORE_CONNECT_API_KEY_ID
  #   APP_STORE_CONNECT_API_ISSUER_ID
  #   APP_STORE_CONNECT_API_KEY_CONTENT  (base64-encoded .p8)
  # ──────────────────────────────────────────────────────────────────────────
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
    )
  end

  # ──────────────────────────────────────────────────────────────────────────
  # sync_certs — Fetch or create signing certificates & provisioning profiles
  # ──────────────────────────────────────────────────────────────────────────
  # Uses fastlane match to pull certs/profiles from the private git repo
  # (https://github.com/mgmacri/ios-certificates.git). Syncs development,
  # appstore, and adhoc types for both the main app and ShareExtension.
  #
  # Usage:
  #   bundle exec fastlane ios sync_certs
  #   bundle exec fastlane ios sync_certs readonly:true   # CI: never create
  #   bundle exec fastlane ios sync_certs skip_clean:true  # skip git check
  # ──────────────────────────────────────────────────────────────────────────
  desc "Sync code-signing certificates and provisioning profiles via match"
  lane :sync_certs do |options|
    api_key = asc_api_key
    readonly = options[:readonly] || is_ci

    ["development", "appstore", "adhoc"].each do |type|
      match(
        type: type,
        app_identifier: ALL_APP_IDS,
        api_key: api_key,
        readonly: readonly,
        force_for_new_devices: !readonly,
      )
    end
  end

  # ──────────────────────────────────────────────────────────────────────────
  # beta — Build and upload to TestFlight
  # ──────────────────────────────────────────────────────────────────────────
  # Increments the build number, syncs certs, builds the Flutter app with
  # the Runner scheme, and pushes to TestFlight. The build number is set to
  # the current CI build number or timestamp to guarantee uniqueness.
  #
  # Usage:
  #   bundle exec fastlane ios beta
  #   bundle exec fastlane ios beta skip_clean:true
  # ──────────────────────────────────────────────────────────────────────────
  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    api_key = asc_api_key

    # Sync signing certs (read-only on CI)
    sync_certs(readonly: is_ci, skip_clean: true)

    # Increment build number for uniqueness. Uses CI build number if
    # available, otherwise falls back to current timestamp.
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: XCODE_PROJECT,
      build_number: build_number,
    )

    # Build the app with proper export options including ShareExtension
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      output_name: "RunThru.ipa",
      export_options: {
        provisioningProfiles: {
          MAIN_APP_ID => "match AppStore #{MAIN_APP_ID}",
          SHARE_EXT_ID => "match AppStore #{SHARE_EXT_ID}",
        },
      },
    )

    # Upload to TestFlight. Skip waiting so CI doesn't block.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  # ──────────────────────────────────────────────────────────────────────────
  # release — Build and upload to App Store
  # ──────────────────────────────────────────────────────────────────────────
  # Similar to beta but uploads to the App Store for production release.
  # Skips metadata and screenshots by default (use the metadata/screenshots
  # lanes for those).
  #
  # Usage:
  #   bundle exec fastlane ios release
  #   bundle exec fastlane ios release submit_for_review:true
  # ──────────────────────────────────────────────────────────────────────────
  desc "Push a new release build to the App Store"
  lane :release do |options|
    api_key = asc_api_key

    # Sync signing certs (read-only on CI)
    sync_certs(readonly: is_ci, skip_clean: true)

    # Increment build number
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: XCODE_PROJECT,
      build_number: build_number,
    )

    # Build the app
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      output_name: "RunThru.ipa",
      export_options: {
        provisioningProfiles: {
          MAIN_APP_ID => "match AppStore #{MAIN_APP_ID}",
          SHARE_EXT_ID => "match AppStore #{SHARE_EXT_ID}",
        },
      },
    )

    # Upload to App Store
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: options[:submit_for_review] || false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
    )
  end

  # ──────────────────────────────────────────────────────────────────────────
  # screenshots — Capture App Store screenshots using snapshot
  # ──────────────────────────────────────────────────────────────────────────
  # Runs the UI tests to capture screenshots for all configured devices and
  # languages. Configure devices/languages in the Snapfile.
  #
  # Usage:
  #   bundle exec fastlane ios screenshots
  # ──────────────────────────────────────────────────────────────────────────
  desc "Capture App Store screenshots"
  lane :screenshots do
    capture_screenshots(
      workspace: WORKSPACE,
      scheme: SCHEME,
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
    )
  end

  # ──────────────────────────────────────────────────────────────────────────
  # metadata — Download or upload App Store metadata using deliver
  # ──────────────────────────────────────────────────────────────────────────
  # Downloads metadata from App Store Connect into fastlane/metadata/ so it
  # can be version-controlled. Use upload:true to push local changes back.
  #
  # Usage:
  #   bundle exec fastlane ios metadata                 # download
  #   bundle exec fastlane ios metadata upload:true     # upload
  # ──────────────────────────────────────────────────────────────────────────
  desc "Download or upload App Store metadata"
  lane :metadata do |options|
    api_key = asc_api_key

    if options[:upload]
      # Push local metadata to App Store Connect
      upload_to_app_store(
        api_key: api_key,
        skip_binary_upload: true,
        skip_screenshots: true,
        force: true,
      )
    else
      # Pull current metadata from App Store Connect
      download_metadata(
        api_key: api_key,
      )
    end
  end

  # ──────────────────────────────────────────────────────────────────────────
  # register_devices — Register new test devices for ad-hoc distribution
  # ──────────────────────────────────────────────────────────────────────────
  # Reads device UDIDs from a file (devices.txt) or you can pass them
  # inline. After registering, automatically refreshes profiles so the
  # new devices are included.
  #
  # Usage:
  #   bundle exec fastlane ios register_devices
  #   (create a devices.txt in the fastlane directory first)
  # ──────────────────────────────────────────────────────────────────────────
  desc "Register new test devices and refresh profiles"
  lane :register_devices_lane do
    api_key = asc_api_key

    # Register devices from a tab-separated file:
    # Device ID  Device Name
    # A123...    Matt's iPhone
    register_devices(
      api_key: api_key,
      devices_file: "./fastlane/devices.txt",
    )

    # Refresh profiles to include newly registered devices
    refresh_profiles(skip_clean: true)
  end

  # ──────────────────────────────────────────────────────────────────────────
  # refresh_profiles — Force-refresh provisioning profiles
  # ──────────────────────────────────────────────────────────────────────────
  # Nukes and re-downloads provisioning profiles for all types. Useful when
  # new devices have been added or profiles have expired.
  #
  # Usage:
  #   bundle exec fastlane ios refresh_profiles
  # ──────────────────────────────────────────────────────────────────────────
  desc "Force-refresh provisioning profiles for all targets"
  lane :refresh_profiles do |options|
    api_key = asc_api_key

    ["development", "appstore", "adhoc"].each do |type|
      match(
        type: type,
        app_identifier: ALL_APP_IDS,
        api_key: api_key,
        force: true,
        force_for_new_devices: true,
      )
    end
  end

end
